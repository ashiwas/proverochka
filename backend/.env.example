# Подключение к PostgreSQL
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# Порт API
PORT=4000

# Origin фронтенда для CORS
CORS_ORIGIN=http://localhost:5173

# Секрет для подписи JWT (обязательно сменить в проде!)
JWT_SECRET=change-me-to-a-long-random-string

# Срок жизни access-токена (короткий: обновляется по refresh-токену)
JWT_EXPIRES_IN=15m

# Срок жизни refresh-токена в днях
REFRESH_TOKEN_DAYS=30

# Данные первого администратора для сид-скрипта
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin123
