generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

// Kanban columns:
// NEW              -> Новый лид
// DEADLINE_SHIFT   -> Перенос сроков
// GET_FEEDBACK     -> Получить обратную связь
// WARM             -> Теплые
// AWAITING_PAYMENT -> Ждем оплату
// IN_PROGRESS      -> В работе
// CLOSED           -> Закрытые
enum LeadStatus {
  NEW
  DEADLINE_SHIFT
  GET_FEEDBACK
  WARM
  AWAITING_PAYMENT
  IN_PROGRESS
  CLOSED
}

enum TaskType {
  CALL            // Позвонить
  PROMISED_CALL   // Обещал позвонить
  GET_FEEDBACK    // Получить обратную связь
  WORK_CHECK      // Проверка работы
  START_WORK      // Запуск в работу
  OTHER           // Другое
}

// OVERDUE is derived at read-time (status == ACTIVE && dueAt < now),
// so it is intentionally NOT a stored value here.
enum TaskStatus {
  ACTIVE
  DONE
}

enum LeadHistoryAction {
  LEAD_CREATED
  LEAD_UPDATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_DELETED
  COMMENT_ADDED
  COMMENT_DELETED
}

model User {
  id           String   @id @default(uuid())
  name         String
  login        String   @unique
  passwordHash String
  role         Role     @default(MANAGER)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads         Lead[]         @relation("LeadAssignee")
  tasks         Task[]         @relation("TaskAssignee")
  comments      Comment[]
  history       LeadHistory[]
  refreshTokens RefreshToken[]
  proposals     Proposal[]
}

// Хранится только хэш токена (sha256), сам токен живёт у клиента.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Lead {
  id            String     @id @default(uuid())
  companyName   String
  contactName   String
  mainPhone     String
  // Array of { name: string, phone: string }
  extraPhones   Json       @default("[]")
  // Цифры всех номеров (main + доп.) через пробел — для поиска по телефону на стороне БД.
  phoneSearch   String     @default("")
  website       String?
  yandexMapsUrl String?
  twoGisUrl     String?
  // Город клиента и его таймзона в формате IANA (напр. "Europe/Moscow").
  // GMT-смещение и текущее время в городе вычисляются из timezone на лету.
  city          String?
  timezone      String?
  status        LeadStatus @default(NEW)
  assigneeId    String
  assignee      User       @relation("LeadAssignee", fields: [assigneeId], references: [id])
  // Мягкое удаление: лид не стирается физически, а помечается датой.
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tasks     Task[]
  comments  Comment[]
  history   LeadHistory[]
  proposals Proposal[]

  @@index([assigneeId])
  @@index([status])
  @@index([deletedAt])
  @@index([phoneSearch])
  @@index([timezone])
}

model Task {
  id          String     @id @default(uuid())
  type        TaskType   @default(CALL)
  text        String
  dueAt       DateTime
  status      TaskStatus @default(ACTIVE)
  completedAt DateTime?
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId  String
  assignee    User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([assigneeId])
  @@index([leadId])
  @@index([status])
  @@index([dueAt])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadHistory {
  id        String            @id @default(uuid())
  leadId    String
  lead      Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  action    LeadHistoryAction
  details   Json?
  createdAt DateTime          @default(now())

  @@index([leadId])
}

// ───────────────────────── Коммерческие предложения (КП) ─────────────────────────

// Библиотека слайдов-заготовок (конструктор админа). Каждый слайд — отдельный
// PDF или картинка (PNG/JPEG). Содержимое файла хранится прямо в БД (bytea).
// Один или несколько слайдов можно пометить «слайдом с ценой»: на него при
// генерации КП наносится стоимость в заданной (относительной) позиции.
model ProposalSlide {
  id           String   @id @default(uuid())
  title        String
  fileName     String
  mimeType     String
  data         Bytes
  // Габариты страницы/картинки (в точках/пикселях) — чтобы фронт строил превью
  // с верной пропорцией, а бэкенд точно позиционировал цену.
  pageWidth    Float    @default(0)
  pageHeight   Float    @default(0)
  // Слайд с областью для цены.
  isPriceSlide Boolean  @default(false)
  // Относительная позиция (0..1) и размер шрифта блока с ценой.
  priceX       Float    @default(0.5)
  priceY       Float    @default(0.5)
  priceFontSize Int     @default(28)
  // Выравнивание блока цены: left | center | right.
  priceAlign   String   @default("center")
  // Цвет основной (итоговой) цены в HEX, напр. "#1A1A1A".
  priceColor   String   @default("#1A1A1A")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
}

// Сохранённое КП менеджера: какой набор слайдов и какие цены. Готовый PDF
// не хранится — он собирается на лету при скачивании (можно получить в любой момент).
model Proposal {
  id              String   @id @default(uuid())
  title           String
  // Порядок слайдов: массив id из ProposalSlide (["id1","id2",...]).
  slideIds        Json     @default("[]")
  priceOriginal   Float?
  priceDiscounted Float?
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([authorId])
  @@index([leadId])
}
